# Copy to ../.local/api.env (git-ignored) for local development.
# Quote values that contain shell characters, for example JWT_SIGNING_KEY='...'.

# Address to listen on.
MAPLE_ADDR=:8080

# Postgres. The API creates the schema on an empty database and applies its
# migrations on every start (tracked in go_schema_migrations).
DATABASE_URL=postgres://localhost/maple_dev

# Signs sign-in tokens. At least 32 characters. Keep the old Django SECRET_KEY
# here if you are moving an existing database, so current sessions keep working.
JWT_SIGNING_KEY=

# Comma-separated origins allowed to call the API from a browser (Expo web).
CORS_ORIGINS=http://localhost:8081

# Token lifetimes.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Set to true in production to block sign-in until the email is verified.
REQUIRE_EMAIL_VERIFICATION=false

# Set to true only behind a proxy you control, so X-Forwarded-For is trusted.
TRUST_PROXY_HEADERS=false

# Payments: a fake mobile money provider for development (refused when
# APP_ENV=production), and the secret providers sign webhooks with (32+ chars).
FINANCE_SANDBOX=false
FINANCE_WEBHOOK_SECRET=

# Where emailed links open the app.
APP_URL=http://localhost:8081
