# Copy to ../.local/api.env (git-ignored) for local development.
# Quote values that contain shell characters, for example JWT_SIGNING_KEY='...'.

# Address to listen on.
MAPLE_ADDR=:8080

# The same Postgres database Django uses. Go reads Django's account tables and
# owns its own tables (tracked in go_schema_migrations).
DATABASE_URL=postgres://localhost/maple_dev

# Must equal Django's SECRET_KEY while both backends run, so tokens work on both.
# At least 32 characters.
JWT_SIGNING_KEY=

# Django API that serves every path Go doesn't handle yet. Leave empty to disable.
LEGACY_API_URL=http://localhost:8000

# Comma-separated origins allowed to call the API from a browser (Expo web).
CORS_ORIGINS=http://localhost:8081

# Token lifetimes.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Set to true in production to block sign-in until the email is verified.
REQUIRE_EMAIL_VERIFICATION=false

# Set to true only behind a proxy you control, so X-Forwarded-For is trusted.
TRUST_PROXY_HEADERS=false
