# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
# At least 32 characters. Keep the old Django SECRET_KEY here to keep existing sessions.
JWT_SIGNING_KEY=change-me-to-a-long-random-string-of-32-plus-chars
# At least 32 characters; mobile money providers sign webhooks with it.
FINANCE_WEBHOOK_SECRET=change-me-to-another-long-random-string
# Sandbox payments for development only (refused when APP_ENV=production).
FINANCE_SANDBOX=true
CORS_ORIGINS=http://localhost:8081
APP_URL=http://localhost:8081
# Leave SMTP_HOST empty to write sign-up emails to the API log instead.
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@maple.school
